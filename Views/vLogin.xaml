<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mmaldonadoT3.Views.vLogin"
             Title="vLogin">
    <VerticalStackLayout>
        <Label 
            Text="Semana 2 Elementos Gui!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Image
            Source="logo.png"
            WidthRequest="300"></Image>

        <Grid RowSpacing="15" ColumnSpacing="10"
      HorizontalOptions="Center"
      VerticalOptions="Center"
      >
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label
        Text="Usuario"
        FontSize="18"
        Grid.Row="0"
        Grid.Column="0">
            </Label>
            <Entry
        x:Name="txtUsuario"
        Placeholder="Ingresa al Usuario"
        Grid.Row="0"
        Grid.Column="1">
            </Entry>
            <Label
        Text="Clave"
        FontSize="18"
        Grid.Row="1"
        Grid.Column="0">
            </Label>
            <Entry
        x:Name="txtClave"
        Placeholder="Ingrese la clave"
        IsPassword="True"
        Grid.Row="1"
        Grid.Column="1">
            </Entry>
            <Button x:Name="btnIniciarSesion"
            Text="Iniciar Secion"
            Clicked="btnIniciarSesion_Clicked"
            Grid.Row="2"
            Grid.Column="0">

            </Button>
            <Button
        x:Name="btnRegistrar"
        Text="Registrar Usuario"
        Clicked="btnRegistrar_Clicked"
        Grid.Row="2"
        Grid.Column="1"></Button>


        </Grid>


    </VerticalStackLayout>
</ContentPage>